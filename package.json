{
  "name": "tally",
  "private": true,
  "type": "module",
  "description": "Split shared costs with flatmates and friends, and settle up in as few payments as possible.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @tally/api",
    "dev:web": "npm run dev -w @tally/web",
    "build": "npm run build -w @tally/web && npm run build -w @tally/api",
    "start": "node apps/api/dist/main.js",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
